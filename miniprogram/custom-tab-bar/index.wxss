.bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: #FFFFFF; border-top: 1rpx solid #EBEBEB; padding-bottom: env(safe-area-inset-bottom); z-index: 100; }
.item { flex: 1; height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 20rpx; color: #111111; position: relative; }
.item.on { color: #722F3E; font-weight: 600; }
.item.on::before { content: ""; position: absolute; top: 0; left: 50%; width: 40rpx; height: 4rpx; margin-left: -20rpx; border-radius: 0 0 4rpx 4rpx; background: #722F3E; }
.ic { width: 44rpx; height: 44rpx; margin-bottom: 4rpx; }
