.mc { background: var(--c-white); border-radius: 20rpx; padding: 24rpx 16rpx; box-shadow: var(--shadow); border: 1rpx solid var(--c-line); }
.head { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 16rpx; }
.nav { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.nav image { width: 36rpx; height: 36rpx; }
.t { font-size: 30rpx; font-weight: 600; }
.grid { display: flex; flex-wrap: wrap; }
.wk { margin-bottom: 8rpx; }
.w { width: 14.2857%; text-align: center; font-size: 22rpx; color: var(--c-ink); }
.cell { width: 14.2857%; height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; box-sizing: border-box; position: relative; }
.d { font-size: 28rpx; font-family: var(--font-num); }
.n { font-size: 18rpx; color: var(--c-accent); }
.out .d { color: var(--c-light-grey); }
.dis .d { color: var(--c-muted); }
.today .d { color: var(--c-accent); font-weight: 600; }
.today::after { content: ''; position: absolute; bottom: 10rpx; left: 50%; width: 24rpx; height: 4rpx; margin-left: -12rpx; border-radius: 2rpx; background: var(--c-accent); }
.sel { background: var(--c-accent); }
.sel::after { background: var(--c-white); }
.sel .d, .sel .n { color: var(--c-on-accent); }
