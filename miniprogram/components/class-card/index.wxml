<wxs src="../../utils/fmt.wxs" module="f" />
<view wx:if="{{mode === 'student'}}" class="sc {{item.status === 'cancelled' ? 'cancelled' : ''}} {{item.phase === 'ended' ? 'ended' : ''}}" bindtap="tap">
  <view class="sc-top">
	<view class="t-av">
	  <image src="{{item.teacherAvatar && !failed.t ? item.teacherAvatar : defaultAvatar}}" mode="aspectFill" data-k="t" binderror="onAvatarError" />
	</view>
	<view class="body">
	  <view class="row1">
		<text class="name ellipsis">{{item.name}}</text>
		<text class="phase {{item.phase}}">{{f.label('phase', item.phase)}}</text>
	  </view>
	  <view class="meta">
		<image class="mi" src="/assets/icons/clock-muted.svg" /><text>{{item.startTime}} - {{item.endTime}}</text>
		<block wx:if="{{item.room}}"><text class="ml">教室 {{item.room}}</text></block>
	  </view>
	  <view class="meta">
		<text>{{item.teacherName}}</text>
		<view wx:if="{{item.level}}" class="stars ml"><text wx:for="{{[1, 2, 3, 4, 5]}}" wx:for-item="n" wx:key="*this" class="star {{item.level >= n ? 'on' : ''}}"></text></view>
	  </view>
	  <view wx:if="{{item.status === 'cancelled' && item.cancelReason}}" class="reason">取消原因：{{item.cancelReason}}</view>
	</view>
  </view>
  <view wx:if="{{item.status !== 'cancelled'}}" class="sc-bottom">
	<view class="booked">
	  <view class="avs">
		<view wx:for="{{item.bookedStudents}}" wx:key="id" class="av">
		  <image src="{{item.avatar && !failed[item.id] ? item.avatar : defaultAvatar}}" mode="aspectFill" data-k="{{item.id}}" binderror="onAvatarError" />
		</view>
		<view wx:if="{{item.bookedCount > item.bookedStudents.length}}" class="av more">+{{item.bookedCount - item.bookedStudents.length}}</view>
	  </view>
	  <text class="tiny muted">{{item.bookedCount ? '已约 ' + item.bookedCount + (item.capacity ? ' / ' + item.capacity : '') : '暂无预约'}}</text>
	</view>
	<view class="act-row">
	  <block wx:if="{{item.state === 'checked_in'}}">
		<view class="done"><image src="/assets/icons/check-active.svg" /><text>已预约</text></view>
		<text wx:if="{{item.canCancelBooking}}" class="hint accent" catchtap="cancelBook">取消预约</text>
	  </block>
	  <block wx:elif="{{item.canBook}}">
		<button class="btn small" hover-class="btn-hover" disabled="{{busy}}" catchtap="book">预约</button>
	  </block>
	  <block wx:elif="{{item.bookingStatus === 'booked' && item.phase !== 'ended'}}">
		<text class="tag">已预约</text>
		<text wx:if="{{item.canCancelBooking}}" class="hint accent" catchtap="cancelBook">取消预约</text>
	  </block>
	  <block wx:else>
		<text class="hint">{{item.hint}}</text>
	  </block>
	</view>
  </view>
</view>
<view wx:else class="cc {{item.status === 'cancelled' ? 'cancelled' : ''}} {{item.ended || item.status === 'completed' ? 'ended' : ''}}" bindtap="tap">
  <view class="time">
	<text class="st">{{item.startTime}}</text>
	<text class="et">{{item.endTime}}</text>
  </view>
  <view class="bar"></view>
  <view class="body">
	<view class="row1">
	  <text class="name ellipsis">{{item.name}}</text>
	  <text wx:if="{{item.status === 'cancelled'}}" class="tag danger">已取消</text>
	</view>
	<view class="meta">
	  <image class="mi" src="/assets/icons/teacher-muted.svg" /><text>{{item.teacherName}}</text>
	  <image class="mi ml" src="/assets/icons/clock-muted.svg" /><text>{{item.duration}}分钟</text>
	</view>
	<view wx:if="{{item.status === 'cancelled' && item.cancelReason}}" class="reason">取消原因：{{item.cancelReason}}</view>
	<view wx:if="{{mode === 'staff' && item.status !== 'cancelled'}}" class="meta stat">
	  <text>已约 <text class="b">{{item.booked || 0}}</text></text>
	  <text class="ml2">已签到 <text class="b">{{item.checkedIn || 0}}</text></text>
	  <text wx:if="{{item.hasRoster}}" class="ml2">未签到 <text class="b">{{item.notCheckedIn}}</text></text>
	</view>
	<view wx:if="{{mode === 'student' && item.status !== 'cancelled' && item.capacity}}" class="meta stat">
	  <text>已约 <text class="b">{{item.bookedCount}}</text> / {{item.capacity}}</text>
	  <text class="ml2">剩余 <text class="b">{{item.remaining}}</text></text>
	</view>
	<slot></slot>
  </view>
  <view wx:if="{{mode === 'student' && item.status !== 'cancelled'}}" class="act">
	<block wx:if="{{item.state === 'checked_in'}}">
	  <view class="done"><image src="/assets/icons/check-active.svg" /><text>已预约</text></view>
	  <text wx:if="{{item.canCancelBooking}}" class="hint accent" catchtap="cancelBook">取消预约</text>
	</block>
	<block wx:elif="{{item.canBook}}">
	  <button class="btn small" hover-class="btn-hover" disabled="{{busy}}" catchtap="book">预约</button>
	</block>
	<block wx:elif="{{item.bookingStatus === 'booked' || item.state === 'booked'}}">
	  <text class="tag">已预约</text>
	  <text wx:if="{{item.canCancelBooking}}" class="hint accent" catchtap="cancelBook">取消预约</text>
	  <text wx:else class="hint">{{item.hint}}</text>
	</block>
	<block wx:else>
	  <button class="btn small" disabled>{{item.state === 'full' ? '已满' : '预约'}}</button>
	  <text class="hint">{{item.hint}}</text>
	</block>
  </view>
  <image wx:if="{{mode === 'staff'}}" class="arrow" src="/assets/icons/right-muted.svg" />
</view>
