<view class="container">
  <view class="brand">
	<view class="logo">FQ</view>
	<view class="page-title">{{studioName || 'FQ Dance Studio'}}</view>
	<view class="page-sub">欢迎加入，完成注册后即可查看课程并签到</view>
  </view>

  <view class="segment mb">
	<view wx:for="{{modes}}" wx:key="key" class="seg {{mode === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="setMode">{{item.text}}</view>
  </view>

  <view class="form">
	<view class="field">
	  <text class="label">姓名</text>
	  <input class="control" value="{{name}}" placeholder="必填，请输入真实姓名" placeholder-class="placeholder" maxlength="30" data-k="name" bindinput="onInput" />
	</view>
	<view class="field">
	  <text class="label">微信号</text>
	  <input class="control" value="{{wxid}}" placeholder="{{mode === 'staff' ? '选填，便于店主搜索授权' : '选填，便于老师联系'}}" placeholder-class="placeholder" maxlength="40" data-k="wxid" bindinput="onInput" />
	</view>

	<block wx:if="{{mode === 'student'}}">
	  <view wx:if="{{!smsMode}}" class="field">
		<text class="label">手机号</text>
		<button class="btn sm" hover-class="btn-hover" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">{{wxPhoneOk ? '已授权微信手机号' : '微信手机号快捷验证'}}</button>
	  </view>
	  <block wx:else>
		<view class="field">
		  <text class="label">手机号</text>
		  <input class="control" type="number" value="{{phone}}" placeholder="必填，中国大陆手机号" placeholder-class="placeholder" maxlength="11" data-k="phone" bindinput="onInput" />
		</view>
		<view class="field">
		  <text class="label">验证码</text>
		  <input class="control" type="number" value="{{smsCode}}" placeholder="6位短信验证码" placeholder-class="placeholder" maxlength="6" data-k="smsCode" bindinput="onInput" />
		  <text class="small {{countdown > 0 ? 'muted' : 'accent'}}" bindtap="sendSms">{{countdown > 0 ? countdown + '秒后重发' : '获取验证码'}}</text>
		</view>
	  </block>
	</block>
  </view>

  <block wx:if="{{mode === 'student'}}">
	<view wx:if="{{!smsMode}}" class="hint">无法使用微信快捷验证？<text class="accent" bindtap="useSms">改用短信验证码</text></view>
	<view wx:else class="hint"><text class="accent" bindtap="useWx">返回微信手机号快捷验证</text></view>
	<view class="hint">手机号为必填项，仅用于身份核验与课程联系，不会用于其他用途。同一手机号只能注册一个学员账号，如提示已注册请联系管理员。若前台已用该手机号为你登记档案，验证后将自动关联。</view>
  </block>
  <view wx:if="{{mode === 'staff'}}" class="hint">员工无需邀请码：注册后由店主或管理员在「员工管理」中授予教师/管理员角色。</view>

  <view class="agree row" bindtap="toggleAgree">
	<view class="ck {{agree ? 'on' : ''}}"><image wx:if="{{agree}}" src="/assets/icons/check-white.svg" /></view>
	<text class="small grey">我已阅读并同意<text class="accent" catchtap="toPrivacy">《隐私政策》</text>与<text class="accent" catchtap="toPrivacy">《用户服务协议》</text></text>
  </view>

  <button class="btn mt" hover-class="btn-hover" disabled="{{busy}}" bindtap="submit">{{submitText}}</button>
</view>
