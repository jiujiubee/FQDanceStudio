.posters { width: 100vw; height: 360rpx; margin: -32rpx -32rpx 24rpx; overflow: hidden; background: #F5F5F5; }
.poster-item { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.poster { position: relative; z-index: 1; width: 100%; height: 100%; display: block; }
.poster-ph { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(90deg, #F0F0F0, #FAFAFA, #F0F0F0); }
.poster-fallback { width: 120rpx; height: 120rpx; opacity: .5; }
.teacher { padding: 20rpx 0; border-bottom: 1rpx solid #EEEEEE; }
.teacher:last-child { border-bottom: none; }
.teacher .avatar { width: 96rpx; height: 96rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.teacher .arrow { width: 32rpx; height: 32rpx; }
.card > .row > .avatar { width: 96rpx; height: 96rpx; border-radius: 50%; overflow: hidden; margin-right: 20rpx; flex-shrink: 0; }
.stars { width: auto; margin: 0 -32rpx; white-space: nowrap; }
.stars-track { display: inline-block; white-space: nowrap; padding: 8rpx 32rpx 4rpx; }
.star-t { display: inline-block; vertical-align: top; width: 140rpx; margin-right: 24rpx; text-align: center; white-space: normal; }
.star-t:last-child { margin-right: 0; }
.star-avatar { width: 110rpx; height: 110rpx; border-radius: 50%; overflow: hidden; display: block; margin: 0 auto; background: #F5F5F5; border: 2rpx solid var(--c-line); box-sizing: border-box; flex-shrink: 0; }
.star-t:active .star-avatar { border-color: var(--c-accent); }
.star-name { width: 100%; margin-top: 16rpx; font-size: 24rpx; line-height: 32rpx; font-weight: 500; color: var(--c-ink); text-align: center; white-space: normal; word-break: break-all; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
