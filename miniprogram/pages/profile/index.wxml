<wxs src="../../utils/fmt.wxs" module="f" />
<view class="container">
  <view class="av-wrap">
	<button class="av-btn" open-type="chooseAvatar" bindchooseavatar="onAvatar">
	  <view class="avatar lg">
		<image wx:if="{{form.avatar}}" src="{{form.avatar}}" mode="aspectFill" />
		<text wx:else>{{f.initial(form.name)}}</text>
	  </view>
	</button>
	<text class="tiny muted">点击更换头像</text>
  </view>

  <view class="form">
	<view class="field">
	  <text class="label">姓名</text>
	  <input class="control" type="nickname" value="{{form.name}}" maxlength="30" data-k="name" bindinput="onInput" />
	</view>
	<block wx:if="{{isStudent}}">
	  <view class="field">
		<text class="label">微信号</text>
		<input class="control" value="{{form.wxid}}" placeholder="选填" placeholder-class="placeholder" maxlength="40" data-k="wxid" bindinput="onInput" />
	  </view>
	  <view class="field">
		<text class="label">手机号</text>
		<input class="control" type="number" value="{{form.phone}}" placeholder="选填" placeholder-class="placeholder" maxlength="11" data-k="phone" bindinput="onInput" />
	  </view>
	  <view class="field">
		<text class="label">性别</text>
		<picker class="control" range="{{genders}}" range-key="text" value="{{genderIndex}}" bindchange="onGender"><view>{{genders[genderIndex].text}}</view></picker>
	  </view>
	  <view class="field">
		<text class="label">生日</text>
		<picker class="control" mode="date" value="{{form.birthday}}" end="{{today}}" bindchange="onBirthday"><view class="{{form.birthday ? '' : 'placeholder'}}">{{form.birthday || '选填'}}</view></picker>
	  </view>
	  <view class="field">
		<text class="label">紧急联系人</text>
		<input class="control" value="{{form.emergencyContact}}" placeholder="姓名 + 电话，选填" placeholder-class="placeholder" maxlength="60" data-k="emergencyContact" bindinput="onInput" />
	  </view>
	</block>
	<view wx:if="{{isTeacher}}" class="field column">
	  <text class="label">个人简介</text>
	  <textarea class="textarea" value="{{form.bio}}" maxlength="300" placeholder="选填" data-k="bio" bindinput="onInput" />
	</view>
  </view>

  <button class="btn mt" hover-class="btn-hover" disabled="{{busy}}" bindtap="save">保存</button>
</view>
