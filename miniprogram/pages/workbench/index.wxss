.stats { padding: 32rpx 16rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 16rpx 8rpx; }
.g { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; font-size: 24rpx; color: var(--c-ink); }
.gi { width: 88rpx; height: 88rpx; border-radius: 24rpx; background: var(--c-surface-2); border: 1rpx solid var(--c-line); display: flex; align-items: center; justify-content: center; margin-bottom: 12rpx; }
.gi image { width: 44rpx; height: 44rpx; }
.segment.sm { width: 240rpx; padding: 4rpx; }
.segment.sm .seg { height: 52rpx; line-height: 52rpx; font-size: 22rpx; font-weight: 400; }
